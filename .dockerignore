# Local state / secrets — must never end up in the image.
.env
.env.local
.env.local.example
.agent-config.json
*.pid
logs/

# Runtime-generated data — created/written by the app at runtime, on the
# mounted volume in every real deploy (see Dockerfile "Runtime state"). Never
# source; must never ship baked INTO the image with a stale operator's data.
.state/

# Build / runtime junk
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv-*/

# Git / editor / OS
.git/
.gitignore
.github/
.vscode/
.idea/
.DS_Store

# Docs / notes that don't belong in the runtime image
docs/
*.md
!README.md
skills/
skills-lock.json
tests/

# Other local-machine / agent-session directories that never belong in the
# image and are irrelevant to any deploy target.
.backups/
.claude/
scratchpad/

# services/pathiel_data_api is its own deploy unit with its own Dockerfile,
# its own build context (services/pathiel_data_api/.dockerignore), and its own
# Postgres-backed dependency set — never bundled into this image, so it does
# not need to be part of this build context either.
services/pathiel_data_api/
