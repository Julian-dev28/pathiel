# Local state / secrets — must never end up in the image.
.env
.env.local
.agent-config.json
.agent-memory.json
.dsl-state.json
*.pid
logs/

# Build / runtime junk
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.venv/
.venv-*/
hf-cache/

# Host-only work areas (trader-logs is bind-mounted at runtime; scratch/ is
# agent working data — 8+ GB of gauntlet archives must never enter the image)
scratch/
trader-logs/

# Git / editor / OS
.git/
.gitignore
.github/
.vscode/
.idea/
.DS_Store

# Docs / notes that don't belong in the runtime image
docs/
*.md
!README.md
skills/
tests/
