# pathiel keys and settings for a plugin install.
#
# /pathiel:setup copies this file to ~/.pathiel/.env.local and sets its mode
# to 600. Fill in the copy, never this file.
#
# Leave the three Hyperliquid lines empty for read-only mode: prices, candles,
# books, funding and the desk briefs all work with no key. Order tools answer
# "no key configured, read-only mode".

# ── Network ─────────────────────────────────────────────────────────────────
#
# pathiel runs on the Hyperliquid TESTNET unless this file says otherwise.
# Testnet money is not real. To trade REAL MONEY on mainnet, remove the '#'
# from the next line. Every order then risks real funds, and you can lose
# all of what the account holds.
# PATHIEL_NETWORK=mainnet
#
# Testnet and mainnet use different API wallets. A wallet approved on mainnet
# does not exist on testnet: create and approve a separate API wallet in the
# testnet app (https://app.hyperliquid-testnet.xyz, More, API) and fund the
# testnet account with test USDC there.

# ── Hyperliquid API wallet ──────────────────────────────────────────────────
#
# An API wallet (agent wallet), created in the Hyperliquid app under More, API
# and approved by your main account. It can place and cancel orders. It
# cannot withdraw.
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=

# Your main account address: where the funds sit and the account the API
# wallet trades for. A public address, not a secret. It must differ from
# HYPERLIQUID_WALLET_ADDRESS.
HYPERLIQUID_MASTER_ADDRESS=

# Never add your main account's private key to this file. pathiel never needs
# it here. The one step that needs it (approving the builder fee, once) asks
# for it at a hidden prompt in your own terminal and keeps it nowhere.

# ── Optional intel keys (free) ──────────────────────────────────────────────
#
# Each one adds a data source to the desk briefs. A missing key skips that
# source; nothing else changes.
#   EIA_API_KEY       US crude and gas inventories   https://www.eia.gov/opendata/
#   FRED_API_KEY      rates, dollar, inflation       https://fred.stlouisfed.org/docs/api/api_key.html
#   CONGRESS_API_KEY  bills and hearings             https://api.congress.gov/sign-up/
# EIA_API_KEY=
# FRED_API_KEY=
# CONGRESS_API_KEY=
