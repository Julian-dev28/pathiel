# Supply-chain defaults for the wallet bundle (docs/security/SUPPLY_CHAIN_2026-10-25.md).
#
# No dependency's install script runs here. Four packages in the tree declare
# one (esbuild, bufferutil, utf-8-validate, keccak) and none is needed: esbuild
# ships its binary as an optional @esbuild/<platform> package, and the other
# three are optional native speedups for Node-side code that never runs in a
# browser bundle. Lifecycle scripts are how the 2025 Shai-Hulud worms and the
# 2026 MALFEX packages ran on install; with this set, a compromised version
# that lands in the tree can still be read by esbuild but cannot execute.
ignore-scripts=true
# A new dependency is recorded at the exact version installed, never a range.
save-exact=true
# Every package comes from the public registry, nothing else.
registry=https://registry.npmjs.org/
