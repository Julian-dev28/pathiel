!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# .env.example is the committed placeholder template; the real one stays local.
.env.local
.env
.env.old
.env.local.old

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

python-service/.checkpoints
python-service/.cache
python-service/__pycache__/
python-service/venv*/
python-service/timesfm/venv*/
venv*/
timesfm/
**/__pycache__/
*.pyc
# Kalshi UI-uploaded credentials (never commit)
.kalshi-credentials.json

# Persistent trade log (local algo data, not for VCS)
data/trade-log.json
data/agent-config.json
data/trade-journal.json
data/trade-journal.json.tmp

# Python service runtime cache/output (generated at runtime)
python-service/_backtest_cache_*.json
python-service/live_analysis_cache.json
python-service/live_analysis_results.json
python-service/live_fills.json
python-service/research_cache.json

.sentient-trader/config.env

# Python daemon logs
logs/
python-service/logs/

# sentient-trader-mcp build artifacts
sentient-trader-mcp/dist/
sentient-trader-mcp/*.egg-info/

# pip/editable build artifacts
*.egg-info/

# Dev/scratch scripts
python-service/backtest_67c.py
python-service/test_tiered_kelly.py
scratch/

# Scanner config
.scanner-config.json

ONE_PAGER.md
THREAD.md
DISTRIBUTE.md

# Agent config (live running config — the .example variants stay committed)
.agent-config.json
.agent-config.rocket.json
.agent-config.shadow.json
.agent-memory.json
.dsl-state.json
.positions-snapshot.json
.monitor-journal.md

# Rust build artifacts
target/

# Editor backups
*.bak

# Local backtest output
backtest-trades.csv
.oi-history.json

# Local timestamped backups (config edits, etc.)
*.bak-*
*.bak2-*
*.bak3-*
log.txt

# Hermes trader logs (datestamped, rotated, unlimited)
trader-logs/

# Archived pre-cutoff logs + config/env backups (counterfactuals use the
# current state from 2026-09-09 11:30 UTC onwards; nothing bridges the gap)
archive/

# Duel A/B log (bind-mounted, runtime JSONL)
duel-logs/

# Desktop-voice / dv runtime logs
dv-logs/

# HuggingFace model cache (mounted into container; binary, re-downloadable)
hf-cache/

# Local agent notes (PROJECT.md) — not part of the project
.hermes/

# Sizing-monitor state (daily cap/revert watchdog) — machine-managed
.ratchet-state.json

# Persistent agent state dir (bind-mounted to /data in the container)
agent-state/
config-models/
