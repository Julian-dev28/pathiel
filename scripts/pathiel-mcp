#!/usr/bin/env bash
# The pathiel MCP server launcher under its old name, kept for MCP clients and
# the container (Dockerfile.mcp) that start scripts/pathiel-mcp. The launcher
# is scripts/pathiel-mcp.sh: the plugin directory wants a file's name to match
# the interpreter that runs it (INTERPRETER_DOES_NOT_FIT_FILE), and
# .claude-plugin/plugin.json starts it as `bash .../pathiel-mcp.sh`.
exec bash "$(cd "$(dirname "$0")" && pwd)/pathiel-mcp.sh" "$@"
